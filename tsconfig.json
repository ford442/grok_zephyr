{
  // Playwright specs (tests/) and colocated src/**/*.test.ts are type-checked
  // by ESLint (tsconfig.eslint.json). tsc excludes tests: several files use
  // partial DOM mocks that fail strict EventTarget / Timeout checks.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["@webgpu/types"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/shaders/*": ["src/shaders/*"],
      "@/core/*": ["src/core/*"],
      "@/physics/*": ["src/physics/*"],
      "@/render/*": ["src/render/*"],
      "@/camera/*": ["src/camera/*"],
      "@/ui/*": ["src/ui/*"],
      "@/utils/*": ["src/utils/*"],
      "@/types/*": ["src/types/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/**/*.test.ts"]
}
